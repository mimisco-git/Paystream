# =====================================================
# PayStream Environment Variables
# Copy this file to .env and fill in your values
# =====================================================

# Circle Developer Console: https://console.circle.com
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_entity_secret_here   # 32-byte hex, generated once

# Arc Testnet RPC
ARC_RPC_URL=https://rpc.arc.testnet.circle.com
ARC_CHAIN_ID=2816

# USDC contract address on Arc testnet
USDC_ARC_ADDRESS=0x3600000000000000000000000000000000000000

# Supabase (free tier works fine for hackathon)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
